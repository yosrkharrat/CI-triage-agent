# Nothing here is required. The dashboard reads the repo root's .env.local,
# which the Python service reads too, for anything not set in this file:
#
#   CI_TRIAGE_REVIEW_TOKEN   the service's review token
#   GROQ_API_KEY             for the "ask about this incident" agent
#
# Set a key here only to override it for the dashboard.
# CI_TRIAGE_URL=http://127.0.0.1:8000
# CI_TRIAGE_ASK_MODEL=openai/gpt-oss-120b
